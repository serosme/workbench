{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workbench",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workbench-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "workbench-r2"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true },
    "traces": { "enabled": true }
  }
}
