{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workbench",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workbench-db"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true },
    "traces": { "enabled": true }
  }
}
