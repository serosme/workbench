{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "attic-worker",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "attic-d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "attic-r2"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true },
    "traces": { "enabled": true }
  }
}
