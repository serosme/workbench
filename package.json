{
  "name": "workbench",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate:db": "nuxt db generate",
    "dev": "nuxt dev --no-tui",
    "preview": "nuxt preview",
    "build": "nuxt build",
    "backup": "wrangler d1 export DB --remote --output ./db.sql",
    "deploy": "cross-env NITRO_PRESET=cloudflare_module nuxt build && wrangler deploy --keep-vars && wrangler --config .output/server/wrangler.json d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.67",
    "@ai-sdk/vue": "4.0.137",
    "@comark/nuxt": "0.7.0",
    "@internationalized/date": "3.12.4",
    "@libsql/client": "0.18.0",
    "@nuxt/ui": "4.11.3",
    "@nuxthub/core": "0.10.8",
    "ai": "7.0.137",
    "drizzle-orm": "0.45.4",
    "nuxt": "4.6.1",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@iconify-json/lucide": "1.2.142",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-format": "2.0.1",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13",
    "wrangler": "4.149.0"
  }
}
